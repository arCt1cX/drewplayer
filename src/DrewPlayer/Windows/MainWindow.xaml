<Window x:Class="DrewPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DrewPlayer" Width="1280" Height="720" MinWidth="320" MinHeight="180"
        Background="Black" WindowStyle="None" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen" Icon="/Assets/drewplayer.ico">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Grid x:Name="Root" Background="Black" />
</Window>
