<Window x:Class="DrewPlayer.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DrewPlayer" Width="360" Height="200"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        WindowStartupLocation="CenterScreen" Icon="/Assets/drewplayer.ico">
    <Border x:Name="Card" Background="Transparent" Opacity="0">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel.Effect>
                <!-- just a soft glow so it stays readable on light backgrounds -->
                <DropShadowEffect BlurRadius="14" ShadowDepth="0" Opacity="0.55" Color="Black" />
            </StackPanel.Effect>
            <!-- film reel -->
            <Viewbox Width="76" Height="76" RenderTransformOrigin="0.5,0.5">
                <Viewbox.RenderTransform>
                    <RotateTransform x:Name="ReelRotate" Angle="-200" />
                </Viewbox.RenderTransform>
                <Canvas x:Name="Reel" Width="36" Height="36" Opacity="0">
                    <Ellipse x:Name="Ring" Canvas.Left="7" Canvas.Top="7" Width="22" Height="22" StrokeThickness="2" />
                    <Ellipse x:Name="Hub" Canvas.Left="15.5" Canvas.Top="15.5" Width="5" Height="5" />
                    <Ellipse x:Name="D1" Canvas.Left="15.5" Canvas.Top="9" Width="5" Height="5" />
                    <Ellipse x:Name="D2" Canvas.Left="15.5" Canvas.Top="22" Width="5" Height="5" />
                    <Ellipse x:Name="D3" Canvas.Left="9" Canvas.Top="15.5" Width="5" Height="5" />
                    <Ellipse x:Name="D4" Canvas.Left="22" Canvas.Top="15.5" Width="5" Height="5" />
                </Canvas>
            </Viewbox>
            <TextBlock x:Name="Word" Text="drewplayer" Margin="16,0,0,4" VerticalAlignment="Center"
                       FontFamily="Cascadia Mono, Consolas" FontSize="26" Opacity="0">
                <TextBlock.RenderTransform>
                    <TranslateTransform x:Name="WordShift" X="-10" />
                </TextBlock.RenderTransform>
            </TextBlock>
        </StackPanel>
    </Border>
</Window>
